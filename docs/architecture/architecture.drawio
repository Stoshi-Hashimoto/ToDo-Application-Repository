                    <mxGeometry width="50" height="50" relative="1" as="geometry">
                        <mxPoint x="220" y="1" as="sourcePoint"/>
                        <mxPoint x="270" y="1" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="122" value="ALB" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="340" y="22" width="86" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="123" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;《補足3》&lt;/font&gt;&lt;/b&gt;&lt;div&gt;　ECS（Fargate）は &lt;span data-end=&quot;201&quot; data-start=&quot;167&quot;&gt;ENI&lt;/span&gt;&amp;nbsp;を持つが、&lt;br&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;　ALBがないと以下デメリットがある（&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;ALB ターゲットは ip&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;）&lt;/span&gt;&lt;/div&gt;&lt;div&gt;　　・&lt;span style=&quot;background-color: transparent;&quot;&gt;Load Balancing ができない&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;　　　⇒&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;もし&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;taskが3つ&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;なら&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;IPも3つ&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;　　　⇒ユーザーはどこにアクセスするか分からない&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;　　・&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Auto Scaling ができない&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;　　　⇒scaling後の&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;新しいIPが分からないため&lt;/span&gt;&lt;br&gt;&lt;/div&gt;" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="736.5" y="-99.75" width="363.5" height="153" as="geometry"/>
                </mxCell>
                <mxCell id="124" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;《補足2》&lt;/font&gt;&lt;/b&gt;&lt;div&gt;　実務ではClientとALBの間にCloudFrontを配置する&lt;/div&gt;&lt;div&gt;　　・静的資材をキャッシュ&lt;/div&gt;&lt;div&gt;　　・ALB への直接到達を抑える&lt;/div&gt;&lt;div&gt;　　　⇒WAF、Sheildを付与できる&lt;/div&gt;&lt;div&gt;　　・レイテンシ削減&lt;/div&gt;&lt;div&gt;　&lt;/div&gt;&lt;div&gt;　ECS学習がメインで利用者を考慮しないため、&lt;/div&gt;&lt;div&gt;　今回は省略する。&lt;/div&gt;" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="334.08" y="102.24999999999999" width="343.5" height="130" as="geometry"/>
                </mxCell>
